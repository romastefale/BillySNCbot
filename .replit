modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "billy som na caixa"

[[workflows.workflow]]
name = "billy som na caixa"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd myjamrobot && python -m app.bootstrap"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
MYJAM_BASE_URL = "https://11e06a30-8eb8-4b35-898a-75021f322dfa-00-20ivc6wenjjdw.worf.replit.dev"
MYJAM_CODE_OWNER_IDS = "8921622168"
TR3_DATA_DIR = "/home/runner/workspace/myjamrobot/.data"
