# Obrigatórias
MYJAM_TELEGRAM_BOT_TOKEN=
MYJAM_BASE_URL=https://SEU-DOMINIO.railway.app

# SQLite persistente no Railway
MYJAM_DATABASE_URL=sqlite:////app/data/myjamrobot.sqlite3

# Música / APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Opcional
MYJAM_COMMAND_RATE_LIMIT_ENABLED=true
MYJAM_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
MYJAM_COMMAND_RATE_LIMIT_STANDARD_PER_WINDOW=12
MYJAM_COMMAND_RATE_LIMIT_EXPENSIVE_PER_WINDOW=4

# Last.fm importação CSV owner-only (scrobble write API)
# Use MYJAM_LASTFM_API_KEY no Railway; scrobble precisa também de secret + session key.
MYJAM_LASTFM_API_KEY=
MYJAM_LASTFM_API_SECRET=
MYJAM_LASTFM_SESSION_KEY=
MYJAM_LASTFM_SCROBBLE_IMPORT_MAX_FILE_BYTES=1000000
MYJAM_LASTFM_SCROBBLE_IMPORT_MAX_EXPANDED_ITEMS=50000
MYJAM_LASTFM_SCROBBLE_IMPORT_MAX_PER_JOB=2000
MYJAM_LASTFM_SCROBBLE_IMPORT_BATCH_SIZE=50
MYJAM_LASTFM_SCROBBLE_IMPORT_SLEEP_SECONDS=1.2
MYJAM_LASTFM_SCROBBLE_IMPORT_STAGE_SIZE=250
MYJAM_LASTFM_SCROBBLE_IMPORT_STAGE_SLEEP_SECONDS=10
MYJAM_LASTFM_SCROBBLE_IMPORT_SPACING_SECONDS=61
MYJAM_LASTFM_SCROBBLE_IMPORT_REQUIRE_CONFIRM=true
MYJAM_LASTFM_SCROBBLE_IMPORT_STOP_ON_DAILY_LIMIT=true
MYJAM_LASTFM_SCROBBLE_IMPORT_SEND_RETRY_CSV=true
MYJAM_LASTFM_SCROBBLE_IMPORT_SEND_REMAINING_CSV=true
