# Template for local development only. In Railway, configure variables in the service dashboard.
# Never commit a populated copy of this file.

# Required application credentials
MYJAM_TELEGRAM_BOT_TOKEN=
MYJAM_SPOTIFY_CLIENT_ID=
MYJAM_SPOTIFY_CLIENT_SECRET=
MYJAM_LASTFM_API_KEY=
MYJAM_CODE_OWNER_IDS=

# Public URL used by Telegram and Spotify callbacks.
# In Railway, prefer the service variable reference documented in RAILWAY.md.
MYJAM_BASE_URL=https://your-service.up.railway.app

# Persistent Railway volume mounted at /app/data
MYJAM_DATA_DIR=/app/data
MYJAM_DATABASE_URL=sqlite:////app/data/app.db

# Required only for owner-driven Last.fm scrobble imports
MYJAM_LASTFM_API_SECRET=
MYJAM_LASTFM_SESSION_KEY=

# Optional runtime tuning
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
